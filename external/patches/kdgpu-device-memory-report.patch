diff --git a/src/KDGpu/vulkan/vulkan_resource_manager.cpp b/src/KDGpu/vulkan/vulkan_resource_manager.cpp
index 18f36df..6d8c4b0 100644
--- a/src/KDGpu/vulkan/vulkan_resource_manager.cpp

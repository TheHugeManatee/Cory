<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

    <Type Name="Cory::SignalTree">
        <DisplayString>
            {{signaled={internalNodes_._Mypair._Myval2._Myfirst->count_._Storage._Value},capacity={maxSignals_}}}
        </DisplayString>
        <Expand>
            <Item Name="[capacity]">maxSignals_</Item>
            <Item Name="[Internal Nodes]">internalNodes_</Item>
            <Item Name="[Leaf Nodes]">leafNodes_</Item>
        </Expand>
    </Type>

    <Type Name="Cory::SignalTree::InternalNode">
        <DisplayString>{{{count_._Storage._Value}}}</DisplayString>
        <Expand>
            <Item Name="[count]">count_._Storage._Value</Item>
        </Expand>
    </Type>

    <Type Name="Cory::SignalTree::LeafNodeBlock">
        <DisplayString>{{0x{bits_._Storage._Value,Xb}}}</DisplayString>
        <Expand>
            <Item Name="[bits]">bits_._Storage._Value,b</Item>
        </Expand>
    </Type>

    <Type Name="Cory::SlotMapHandle">
        <DisplayString Condition="free_ || index_ == 0xFFFFFFFF">{{invalid}}</DisplayString>
        <DisplayString>{{{index_}_{version_}}}</DisplayString>
        <Expand>
            <Item Name="[index]">index_</Item>
            <Item Name="[version]">version_</Item>
            <Item Name="[free]">free_</Item>
        </Expand>
    </Type>

    <Type Name="Cory::PrivateTypedHandle&lt;*,*&gt;">
        <DisplayString>{handle_}</DisplayString>
        <Expand>
            <Item Name="[handle]">handle_</Item>
        </Expand>
    </Type>

    <Type Name="Cory::SlotMap&lt;*&gt;">
        <DisplayString>{{ size={size()}, capacity={capacity()} }}</DisplayString>
        <Expand>
            <Item Name="[size]">size()</Item>
            <Item Name="[capacity]">capacity()</Item>
            <Item Name="[free]">freeList_.size()</Item>

            <CustomListItems MaxItemsPerView="50" Condition="chunkTable_.size() &gt; 0">
                <Variable Name="_elementIdx" InitialValue="0"/>
                <Variable Name="_capacity" InitialValue="capacity()"/>

                <Size>size()</Size>
                <Loop>
                    <Break Condition="_elementIdx >= _capacity"/>

                    <If Condition="objectAt(_elementIdx).id.free_ == 0">
                        <Item Name="{objectAt(_elementIdx).id}">objectAt(_elementIdx).storage</Item>
                    </If>
                    <Exec>++ _elementIdx</Exec>
                </Loop>
            </CustomListItems>

        </Expand>
    </Type>

    <Type Name="Cory::SlotMap&lt;*&gt;::Chunk">
        <DisplayString>{{ size={CHUNK_SIZE} }}</DisplayString>
        <Expand>
            <Item Name="[size]">CHUNK_SIZE</Item>
            <IndexListItems>
                <Size>CHUNK_SIZE</Size>
                <ValueNode Condition="id[$i].free_ == 0">storage[$i]</ValueNode>
                <ValueNode Condition="id[$i].free_ != 0">id[$i]</ValueNode>
            </IndexListItems>
        </Expand>
    </Type>

    <Type Name="glm::vec&lt;2,*,*&gt;">
        <DisplayString>{{{x}, {y}}}</DisplayString>
        <Expand>
            <Item Name="[x]">x</Item>
            <Item Name="[y]">y</Item>
        </Expand>
    </Type>

    <Type Name="glm::vec&lt;3,*,*&gt;">
        <DisplayString>{{{x}, {y}, {z}}}</DisplayString>
        <Expand>
            <Item Name="[x]">x</Item>
            <Item Name="[y]">y</Item>
            <Item Name="[z]">z</Item>
        </Expand>
    </Type>

    <Type Name="glm::vec&lt;4,*,*&gt;">
        <DisplayString>{{{x}, {y}, {z}, {w}}}</DisplayString>
        <Expand>
            <Item Name="[x]">x</Item>
            <Item Name="[y]">y</Item>
            <Item Name="[z]">z</Item>
            <Item Name="[w]">w</Item>
        </Expand>
    </Type>

    <!--
    <Type Name="glm::mat&lt;4,4,*,*&gt;">
        <DisplayString>{{ Mat 4x4}}</DisplayString>
        <Expand>
            <Item Name="Row 0">glm::vec4{value[0][0], value[1][0], value[2][0], value[3][0]}</Item>
            <Item Name="Row 1">glm::vec4{value[0][1], value[1][1], value[2][1], value[3][1]}</Item>
            <Item Name="Row 2">glm::vec4{value[0][2], value[1][2], value[2][2], value[3][2]}</Item>
            <Item Name="Row 3">glm::vec4{value[0][3], value[1][3], value[2][3], value[3][3]}</Item>
        </Expand>
    </Type>
    -->

    <!-- kdbindings -->
    <Type Name="KDBindings::Property&lt;*&gt;">
        <DisplayString>{{value={m_value}, updater={m_updater}}}</DisplayString>
        <Expand>
            <Item Name="[value]">m_value</Item>
            <Item Name="[valueAboutToChange]">m_valueAboutToChange</Item>
            <Item Name="[valueChanged]">m_valueChanged</Item>
            <Item Name="[destroyed]">m_destroyed</Item>
            <Item Name="[updater]">m_updater</Item>
        </Expand>
    </Type>

</AutoVisualizer>